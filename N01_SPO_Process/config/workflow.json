    "sample_size": 40000,
    "seed": 1729,
    "step_ratio": 0.2,
    "min_step": 0.01,
    "relative_tolerance": 0.01,
    "scan_workers": 3,
    "peak_sigma_proposal": true
  },
  "qm_generation": {
    "executable": "g16",
    "environment_setup": null,
    "scratch": null,
    "cpus": 32,
    "memory": "40GB"
  }
