{
  "project_root": "..",
  "paths": {
    "parameters": "config/elements.json",
    "qm_source": "data_set/refer_QM",
    "cg_reference": "data_set/refer_CG",
    "dataset_manifest": "data_set/refer_CG/dataset.json",
    "templates": "jobs/module_files",
    "rdf_reference": "jobs/refer_files",
    "run": "results/spo_run"
  },
  "runtime": {
    "backend": "slurm",
    "python": "python",
    "lammps_mpi": "lmp_mpi",
    "lammps_serial": "lmp_serial",
    "mpi_launcher": [
      "mpiexec"
    ],
    "md_ranks": 64,
    "qm_workers": 8,
    "qm_batches": 10,
    "environment_setup": null,
    "partition": null,
    "account": null,
    "poll_seconds": 30,
    "timeout_seconds": 86400
